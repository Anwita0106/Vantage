# Set to "foundry" once Azure OpenAI quota is approved and a model is deployed.
# Defaults to "mock" if unset.
VANTAGE_LLM_MODE=mock

# Required only when VANTAGE_LLM_MODE=foundry
AZURE_OPENAI_ENDPOINT=https://vantage-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
